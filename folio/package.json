    "express-rate-limit": "^8.7.1",
    "fflate": "^0.8.3",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "pdf-lib": "^1.17.1",
    "sanitize-html": "^2.18.1"
  }
