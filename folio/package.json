    "check": "node scripts/check.mjs",
    "test": "node scripts/check.mjs && node scripts/e2e.mjs && node scripts/e2e-api.mjs && node scripts/e2e-security.mjs"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
