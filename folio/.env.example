# Copy to .env and edit. Every line is optional.

# Where Folio listens. 127.0.0.1 = this computer only. Use 0.0.0.0 to share on a network,
# but then put it behind HTTPS (see README: "Putting it online").
HOST=127.0.0.1
PORT=3100

# Secret that encrypts the API key stored in the database. At least 32 characters.
# If you do not set it, Folio creates data/secret.key on first start.
# APP_SECRET=

# Set when Folio runs behind a reverse proxy that terminates HTTPS (number of proxies, e.g. 1).
# TRUST_PROXY=1
# Force the Secure flag on the session cookie: 1 (always), 0 (never), auto (when the request is HTTPS).
# COOKIE_SECURE=auto

# Use a key from the environment instead of one saved in the dashboard.
# ANTHROPIC_API_KEY=

# Build placeholder sites without calling the AI (testing). Same as the switch in Settings.
# FOLIO_MOCK_AI=1

# Where uploads, books and the database live. Default: ./data
# FOLIO_DATA_DIR=
